     "ar": "نَعَمْ، هِيَ قَرِيبَةٌ.",
     "tr": "naʿam, hiya qarībah.",
     "en": "Yes, it is near."
    },
    {
     "who": "a",
     "ar": "شُكْرًا.",
     "tr": "shukran.",
     "en": "Thank you."
    }
   ],
   "speakers": {
