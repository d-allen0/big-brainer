  {
   "id": "greeting",
   "title": "Saying hello",
   "lines": [
    {
     "who": "a",
     "ar": "السَّلَامُ عَلَيْكُمْ.",
     "tr": "as-salāmu ʿalaykum.",
     "en": "Peace be upon you (hello)."
    },
    {
     "who": "b",
     "ar": "وَعَلَيْكُمُ السَّلَامُ.",
     "tr": "wa ʿalaykumu s-salām.",
     "en": "And peace be upon you."
    },
    {
     "who": "a",
     "ar": "كَيْفَ حَالُكِ؟",
     "tr": "kayfa ḥāluki?",
     "en": "How are you?"
    },
    {
     "who": "b",
     "ar": "أَنَا بِخَيْرٍ، الْحَمْدُ لِلَّهِ. وَأَنْتَ؟",
     "tr": "ana bi-khayr, al-ḥamdu lillāh. wa-anta?",
     "en": "I am well, thank God. And you?"
    },
    {
     "who": "a",
     "ar": "أَنَا بِخَيْرٍ، شُكْرًا.",
     "tr": "ana bi-khayr, shukran.",
     "en": "I am well, thank you."
    }
   ],
   "speakers": {
    "a": "Ahmad",
    "b": "Layla"
   }
  },
  {
   "id": "names",
   "title": "Meeting someone",
   "lines": [
    {
     "who": "a",
     "ar": "مَرْحَبًا! مَا اسْمُكِ؟",
     "tr": "marḥaban! mā ismuki?",
     "en": "Hello! What is your name?"
    },
    {
     "who": "b",
     "ar": "اِسْمِي لَيْلَى. وَمَا اسْمُكَ؟",
     "tr": "ismī laylā. wa-mā ismuka?",
     "en": "My name is Layla. And what is your name?"
    },
    {
     "who": "a",
     "ar": "اِسْمِي أَحْمَدُ.",
     "tr": "ismī aḥmad.",
     "en": "My name is Ahmad."
    },
    {
     "who": "b",
     "ar": "أَهْلًا وَسَهْلًا يَا أَحْمَدُ.",
     "tr": "ahlan wa sahlan yā aḥmad.",
     "en": "Welcome, Ahmad."
    },
    {
     "who": "a",
     "ar": "شُكْرًا يَا لَيْلَى.",
     "tr": "shukran yā laylā.",
     "en": "Thank you, Layla."
    }
   ],
   "speakers": {
    "a": "Ahmad",
    "b": "Layla"
   }
  },
  {
   "id": "shop",
   "title": "In a shop",
   "lines": [
    {
     "who": "a",
     "ar": "مِنْ فَضْلِكِ، بِكَمْ هَذَا؟",
     "tr": "min faḍliki, bi-kam hādhā?",
     "en": "Please, how much is this?"
    },
    {
     "who": "b",
     "ar": "خَمْسَةُ دَنَانِيرَ.",
     "tr": "khamsatu danānīra.",
     "en": "Five dinars."
    },
    {
     "who": "a",
     "ar": "شُكْرًا. أُرِيدُ هَذَا.",
     "tr": "shukran. urīdu hādhā.",
     "en": "Thank you. I want this."
    },
    {
     "who": "b",
     "ar": "تَفَضَّلْ.",
     "tr": "tafaḍḍal.",
     "en": "Here you are."
    },
    {
     "who": "a",
     "ar": "شُكْرًا جَزِيلًا.",
     "tr": "shukran jazīlan.",
     "en": "Thank you very much."
    },
    {
     "who": "b",
     "ar": "عَفْوًا.",
     "tr": "ʿafwan.",
     "en": "You're welcome."
    }
   ],
   "speakers": {
    "a": "Ahmad",
    "b": "Layla"
   }
  },
  {
